generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PersonalInfo {
  id         Int         @id @default(autoincrement())
  name       String      @default("")
  phone      String      @default("")
  email      String      @default("")
  location   String      @default("")
  github     String      @default("")
  linkedin   String      @default("")
  educations Education[]
  updatedAt  DateTime    @updatedAt
}

model Education {
  id              String       @id @default(uuid())
  school          String
  degree          String
  major           String
  startDate       String
  endDate         String
  region          String       @default("") // City, State or City, Country
  relevantCourses String       @default("")
  gpa             String       @default("") // optional, empty string if not provided
  sortOrder       Int          @default(0)
  personalInfo    PersonalInfo @relation(fields: [personalInfoId], references: [id], onDelete: Cascade)
  personalInfoId  Int
}

// type: "intern" | "project"
// One Experience (e.g. "Perflection.ai Summer Internship") can produce many
// distinct, independently STAR-Q'd Highlights (e.g. one per project/incident
// worth its own resume bullet) — see Highlight below.
model Experience {
  id          String      @id @default(uuid())
  title       String
  org         String
  type        String
  startDate   String      @default("")
  endDate     String      @default("")
  location    String      @default("") // City, State or City, Country, e.g. "Pittsburgh, PA"
  rawInput    String
  chatHistory String      @default("[]") // JSON {role, content}[]
  sessionId   String? // Claude Agent SDK session id, so chat can resume() after reload
  highlights  Highlight[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Highlight {
  id           String     @id @default(uuid())
  title        String     @default("") // short name, e.g. "Fixed an Unauthorized Access Vulnerability"
  situation    String     @default("")
  task         String     @default("")
  action       String     @default("")
  result       String     @default("")
  quantify     String     @default("")
  resumeBullet String     @default("") // polished, resume-ready synthesis of the STAR-Q above
  tags         String     @default("[]") // JSON string[] — role tags, e.g. "backend"
  skills       String     @default("[]") // JSON string[] — concrete tools/tech named in this highlight, e.g. "Ansible"
  sortOrder    Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  experienceId String
}

// The user's global, persisted skills list — the only source of truth for
// what goes in a generated resume's Skills section (see resumeGen.ts's data
// isolation rule). Auto-populated from Highlight.skills during STAR-Q
// extraction, and directly editable by the user on the Profile page.
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String   @default("") // e.g. "Languages", "Cloud & Infrastructure" — optional, user-editable
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ResumeTemplate {
  id          String   @id @default(uuid())
  name        String
  typstSource String
  isDefault   Boolean  @default(false)
  calibration String? // JSON {intercept, perEntry, perBullet, perChar, realPageHeightPt, calibratedAt}, set async after save
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GeneratedResume {
  id                    String   @id @default(uuid())
  label                 String
  jdSource              String // the raw URL or JD text the user supplied
  jdIsUrl               Boolean  @default(false)
  company               String   @default("") // target company, extracted from the JD by the generation agent
  targetRoleTag         String   @default("") // target role/title, extracted from the JD by the generation agent
  typstSource           String
  selectedHighlightIds  String   @default("[]") // JSON string[]
  chatHistory           String   @default("[]") // JSON {role, content}[]
  sessionId             String? // Claude Agent SDK session id, so chat can resume() after reload
  pdfPath               String?
  createdAt             DateTime @default(now())
}
